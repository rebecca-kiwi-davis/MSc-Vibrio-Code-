# 1. Load libraries
library(dplyr)
library(survival)
library(ggplot2)
library(officer)
library(flextable)

# A. Use SST and SSS from CC paired data
daily_weather_sst <- cc_master_sst %>% distinct(area, date, SST_raw = SST_lag0)
daily_weather_sss <- cc_master_sss %>% distinct(area, date, SSS_raw = SSS_lag0)

# B. Combine datasets and arrange strictly by calendar date to calculate lags
continuous_weather <- daily_weather_sst %>%
  inner_join(daily_weather_sss, by = c("area", "date")) %>%
  arrange(area, date) %>%
  group_by(area) %>%
  mutate(
    SST_lag0_new = SST_raw,
    SST_lag1_new = dplyr::lag(SST_raw, n = 1),
    SST_lag2_new = dplyr::lag(SST_raw, n = 2),
    SST_lag3_new = dplyr::lag(SST_raw, n = 3),
    
    SSS_lag0_new = SSS_raw,
    SSS_lag1_new = dplyr::lag(SSS_raw, n = 1),
    SSS_lag2_new = dplyr::lag(SSS_raw, n = 2),
    SSS_lag3_new = dplyr::lag(SSS_raw, n = 3)
  ) %>%
  ungroup() %>%
  select(-SST_raw, -SSS_raw)

# C. Map environmental lags directly to cases
cc_clean_sst <- cc_master_sst %>% select(id, area, isb, date) %>% left_join(continuous_weather, by = c("area", "date"))
cc_clean_sss <- cc_master_sss %>% select(id, area, isb, date) %>% left_join(continuous_weather, by = c("area", "date"))

#2. LOOP, RUN REGRESSIONS, AND EXTRACT CALCULATION MATRIX

target_lags       <- c("lag0", "lag1", "lag2", "lag3")
unique_areas      <- c("cadiz", "charente-maritime", "stockholm")
two_model_results <- data.frame()
