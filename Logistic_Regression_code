# pooled model, univariate logistic regression for SSTmean Pmean, SSSmean, Tmean and Rmean. See if the lagged exposure variables
#are associated with cases

# 1. Load libraries
library(dplyr)
library(survival)
library(officer)
library(flextable)

# 2. Define lags included in the model (Lag 0 is the base variable or date of admission)
cc_data_lags <- cc_data %>%
  arrange(area, id, date) %>%
  group_by(area, id) %>%
  mutate(
    SSTmean_lag_1 = lag(SSTmean, 1), SSTmean_lag_2 = lag(SSTmean, 2), SSTmean_lag_3 = lag(SSTmean, 3),
    Tmean_lag_1   = lag(Tmean, 1),   Tmean_lag_2   = lag(Tmean, 2),   Tmean_lag_3   = lag(Tmean, 3),
    Pmean_lag_1   = lag(Pmean, 1),   Pmean_lag_2   = lag(Pmean, 2),   Pmean_lag_3   = lag(Pmean, 3),
    SSSmean_lag_1 = lag(SSSmean, 1), SSSmean_lag_2 = lag(SSSmean, 2), SSSmean_lag_3 = lag(SSSmean, 3),
    Rmean_lag_1   = lag(Rmean, 1),   Rmean_lag_2   = lag(Rmean, 2),   Rmean_lag_3   = lag(Rmean, 3)
  ) %>%
  ungroup()

# 3. Define configurations
variable_configs <- list(
  list(base_name = "SSTmean", label = "Sea Surface Temperature (SSTmean - Continuous Absolute)"),
  list(base_name = "Tmean",   label = "Air Temperature (Tmean - Continuous Absolute)*"),
  list(base_name = "Pmean",   label = "Precipitation (Pmean - Continuous Absolute)"),
  list(base_name = "SSSmean", label = "Sea Surface Salinity (SSSmean - Continuous Absolute)"),
  list(base_name = "Rmean",   label = "Relative Humidity (Rmean - Continuous Absolute)")
)

lags_to_test      <- 0:3
screening_results <- data.frame()

format_p_value <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", round(p, 3)))
}

# 4. Run loop for each variable and lag combination
for (config in variable_configs) {
  for (current_lag in lags_to_test) {

    # Clean column matching logic for lag 0 vs historical lags
    target_column <- if(current_lag == 0) config$base_name else paste0(config$base_name, "_lag_", current_lag)

    # Filter complete entries for this specific metric
    sub_data <- cc_data_lags %>%
      filter(!is.na(.data[[target_column]]))

    # Verify pairing case-control cross variance
    valid_strata <- sub_data %>%
      group_by(area, id) %>%
      summarise(has_match = any(isb == 1) & any(isb == 0), .groups = "drop") %>%
      filter(has_match)

    final_subset <- sub_data %>%
      inner_join(valid_strata, by = c("area", "id"))

    if (nrow(final_subset) < 10) next

    # show cases used by the model
    actual_cases <- sum(final_subset$isb == 1, na.rm = TRUE)

    formula_obj <- reformulate(c(target_column, "strata(interaction(id, area))"), response = "isb")

    tryCatch({
      mod_run <- clogit(formula_obj, data = final_subset)
      sum_run <- summary(mod_run)$coefficients

      b     <- sum_run[target_column, "coef"]
      se    <- sum_run[target_column, "se(coef)"]
      p_raw <- sum_run[target_column, "Pr(>|z|)"]

      or          <- paste0(round(exp(b), 2), " (", round(exp(b - 1.96*se), 2), ", ", round(exp(b + 1.96*se), 2), ")")
      p_formatted <- format_p_value(p_raw)

      screening_results <- rbind(screening_results, data.frame(
        Parameter = config$label,
        Lag       = paste0("Lag ", current_lag),
        Cases     = actual_cases,
        OR_CI     = or,
        P_Value   = p_formatted,
        sig       = p_raw < 0.05,
        stringsAsFactors = FALSE
      ))
    }, error = function(e){})
  }
}

# 5. Make word doc of outputs
ft_screen_table <- flextable(screening_results %>% select(-sig)) %>%
  font(fontname = "Times New Roman", part = "all") %>%
  fontsize(size = 11, part = "all") %>%
  bold(part = "header") %>%
  align(align = "center", j = c("Lag", "Cases", "OR_CI", "P_Value"), part = "all") %>%
  align(align = "left", j = c("Parameter"), part = "all") %>%
  merge_v(j = c("Parameter", "Cases")) %>%
  border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(border = fp_border(color = "gray80", width = 0.5)) %>%
  set_header_labels(Parameter = "Environmental Exposure Parameter", Lag = "Exposure Lag",
                    Cases = "Total Cases (N)", OR_CI = "Crude Odds Ratio (95% CI)", P_Value = "p-value") %>%
  bold(i = which(screening_results$sig), j = c("OR_CI", "P_Value")) %>%
  autofit()

doc_output <- read_docx() %>%
  body_add_par("Table Z.1: Pooled Single-Variable Screening Associations Across Combined Matched Cohorts (Lags 0-3)", style = "heading 1") %>%
  body_add_flextable(ft_screen_table) %>%
  body_add_par("\nNote: Bold entries indicate statistical significance at the p < 0.05 level. Each parameter row represents a completely distinct, standalone conditional logistic regression framework stratified by the interaction of patient id and study region [strata(interaction(id, area))].", style = "Normal") %>%
  body_add_par("*Warning: Air Temperature (Tmean) and Sea Surface Temperature (SSTmean) exhibit extreme physical multicollinearity (high mutual correlation). They are evaluated here in independent models for diagnostic scoping only and must not be included simultaneously in multivariate regression designs.", style = "Normal")

print(doc_output, target = "MSc_Thesis_Table_Pooled_Screening_Models_Lags.docx")
