    # Identify variables for this loop 
    v_sst <- paste0("SST_", lag_name, "_new")
    v_sss <- paste0("SSS_", lag_name, "_new")
    
    # Filter out missing data
    sst_subset <- cc_clean_sst %>% filter(area == current_area & !is.na(.data[[v_sst]]) & !is.na(id))
    sss_subset <- cc_clean_sss %>% filter(area == current_area & !is.na(.data[[v_sss]]) & !is.na(id))
    
    # Match Cases and controls 
    common_ids <- intersect(sst_subset$id, sss_subset$id)
    sst_final  <- sst_subset %>% filter(id %in% common_ids) %>% arrange(id, isb)
    sss_final  <- sss_subset %>% filter(id %in% common_ids) %>% arrange(id, isb)
    
    # Delete unpaired data
    valid_ids <- sss_final %>%
      group_by(id) %>% summarise(has_match = any(isb == 1) & any(isb == 0), .groups = "drop") %>%
      filter(has_match) %>% pull(id)
    
    sst_final <- sst_final %>% filter(id %in% valid_ids)
    sss_final <- sss_final %>% filter(id %in% valid_ids)
    if (nrow(sss_final) < 10) next
    
    # Define populations
    if (current_area == "cadiz") current_case_count <- 166
    if (current_area == "charente-maritime") current_case_count <- 39
    if (current_area == "stockholm") current_case_count <- 36
    
    # LAYOUT:
    # 1. SST threshold vector tracking continuous values above 18°C
    sss_final$SST_threshold_var <- pmax(sst_final[[v_sst]] - 18, 0)
    # 2. Localized continuous standardized variables (Z-Scores)
    sss_final$sst_scaled_vector <- as.numeric(scale(sst_final[[v_sst]]))
    sss_final$sss_scaled_vector <- as.numeric(scale(sss_final[[v_sss]]))
    
    # 1. SST Threshold model adjusting for scaled continuous salinity
    mod_sst   <- clogit(isb ~ SST_threshold_var + sss_scaled_vector + strata(id), data = sss_final)
    sum_sst   <- summary(mod_sst)$coefficients
    b_sst     <- sum_sst[1, "coef"]
    se_sst    <- sum_sst[1, "se(coef)"]
    p_sst_val <- sum_sst[1, "Pr(>|z|)"]
    
    or_sst_txt <- paste0(round(exp(b_sst), 2), " (", round(exp(b_sst - 1.96*se_sst), 2), ", ", round(exp(b_sst + 1.96*se_sst), 2), ")")
    p_sst_txt  <- format_p(p_sst_val)
    
    #  parameters for the continuous forest figure 
    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name), Variable = "SST (>18°C Threshold per 1°C increase)",
      OR = exp(b_sst), lower = exp(b_sst - 1.96*se_sst), upper = exp(b_sst + 1.96*se_sst)
    ))
    
    # 2. Standardised Continuous Salinity model adjusted for scaled continuous temperature
    mod_sss   <- clogit(isb ~ sss_scaled_vector + sst_scaled_vector + strata(id), data = sss_final)
    sum_sss   <- summary(mod_sss)$coefficients
    b_sss     <- sum_sss[1, "coef"]
    se_sss    <- sum_sss[1, "se(coef)"]
    p_sss_val <- sum_sss[1, "Pr(>|z|)"]
    
    or_sss_txt <- paste0(round(exp(b_sss), 2), " (", round(exp(b_sss - 1.96*se_sss), 2), ", ", round(exp(b_sss + 1.96*se_sss), 2), ")")
    p_sss_txt  <- format_p(p_sss_val)
    
    #  parameters for the continuous forest figure mapping
    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name), Variable = "Salinity (Continuous per 1 SD change)",
      OR = exp(b_sss), lower = exp(b_sss - 1.96*se_sss), upper = exp(b_sss + 1.96*se_sss)
    ))
    
    # Compile data frame rows cleanly 
    sst_row <- data.frame(Region = toupper(current_area), Lag = toupper(lag_name), Cases = current_case_count, Variable = "SST (>18°C)", OR = or_sst_txt, P = p_sst_txt, sig = p_sst_val < 0.05)
    sss_row <- data.frame(Region = toupper(current_area), Lag = toupper(lag_name), Cases = current_case_count, Variable = "Salinity (Continuous 1 SD)", OR = or_sss_txt, P = p_sss_txt, sig = p_sss_val < 0.05)
    two_model_results <- rbind(two_model_results, sst_row, sss_row)
  }
}

