library(ggplot2)

render_gam_surface <- function(grid_data, title_text, filename_text) {
  grid_data$OR_capped <- ifelse(grid_data$OR > 20, 20.1, grid_data$OR)
  grid_data$OR_group  <- cut(grid_data$OR_capped,
                             breaks = c(0, 1.0, 1.5, 2.0, 3.0, 5.0, 7.0, 10.0, 15.0, 20.0, Inf),
                             labels = c("(0.0, 1.0]", "(1.0, 1.5]", "(1.5, 2.0]", "(2.0, 3.0]",
                                        "(3.0, 5.0]", "(5.0, 7.0]", "(7.0, 10.0]", "(10.0, 15.0]",
                                        "(15.0, 20.0]", "(20.0, Inf]"), include.lowest = TRUE)
  
  p <- ggplot(grid_data, aes(x = Salinity, y = SST)) +
    geom_tile(aes(fill = OR_group)) +
    scale_fill_viridis_d(option = "magma", name = "Predicted OR", drop = TRUE) + 
    scale_x_reverse() +
    labs(title = title_text, x = "Salinity (psu) — Decreasing →", y = "SST (°C)") +
    theme_bw() + 
    theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
          plot.title = element_text(face = "bold", size = 11))
  
  ggsave(filename = filename_text, plot = p, width = 6, height = 5, dpi = 300)
}

