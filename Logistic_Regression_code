# Fully Adjusted Model (SST + SSS + Pmean)
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

library(dplyr)
library(survival)
library(officer)
library(flextable)

# 1. Combine all (SST, SSS, and Pmean) and align lags from cc_data
weather_triple <- cc_data %>%
  distinct(area, date, SST = SSTmean, SSS = SSSmean, Pmean_raw = Pmean) %>%
  arrange(area, date) %>%
  group_by(area) %>%
  mutate(
    SST_lag0_new = SST, SST_lag1_new = dplyr::lag(SST, n = 1), SST_lag2_new = dplyr::lag(SST, n = 2), SST_lag3_new = dplyr::lag(SST, n = 3),
    SSS_lag0_new = SSS, SSS_lag1_new = dplyr::lag(SSS, n = 1), SSS_lag2_new = dplyr::lag(SSS, n = 2), SSS_lag3_new = dplyr::lag(SSS, n = 3),
    Pmean_lag0_new = Pmean_raw, Pmean_lag1_new = dplyr::lag(Pmean_raw, n = 1), Pmean_lag2_new = dplyr::lag(Pmean_raw, n = 2), Pmean_lag3_new = dplyr::lag(Pmean_raw, n = 3)
  ) %>%
  ungroup() %>%
  select(-SST, -SSS, -Pmean_raw)

# Map lags to cases
cc_clean_triple <- cc_data %>%
  select(id, area, isb, date) %>%
  left_join(weather_triple, by = c("area", "date"))

target_lags         <- c("lag0", "lag1", "lag2", "lag3")
unique_areas        <- c("cadiz", "charente-maritime", "stockholm")
triple_model_output <- data.frame()

format_p <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", round(p, 3)))
}

# 2. Iterate loops for all regions and lags
for (current_area in unique_areas) {
  for (lag_name in target_lags) {

    v_sst   <- paste0("SST_", lag_name, "_new")
    v_sss   <- paste0("SSS_", lag_name, "_new")
    v_pmean <- paste0("Pmean_", lag_name, "_new")

    # include only paired rows containing all 3 environmental variables
    triple_subset <- cc_clean_triple %>%
      filter(area == current_area & !is.na(.data[[v_sst]]) & !is.na(.data[[v_sss]]) & !is.na(.data[[v_pmean]]) & !is.na(id)) %>%
      group_by(id) %>%
      filter(any(isb == 1) & any(isb == 0)) %>%
      ungroup()

    if (nrow(triple_subset) < 10) next

    actual_case_count <- sum(triple_subset$isb == 1, na.rm = TRUE)


    triple_subset$SST_threshold_var <- pmax(triple_subset[[v_sst]] - 18, 0)
    triple_subset$sss_absolute_psu  <- as.numeric(triple_subset[[v_sss]])
    triple_subset$pmean_scaled_1sd  <- as.numeric(scale(triple_subset[[v_pmean]]))

    # Fit the comprehensive model combining all three exposures concurrently
    mod_triple <- clogit(isb ~ SST_threshold_var + sss_absolute_psu + pmean_scaled_1sd + strata(id), data = triple_subset)
    sum_triple <- summary(mod_triple)$coefficients

    # Extract metrics for all three exposures from the exact same model run
    exposures <- c("SST_threshold_var", "sss_absolute_psu", "pmean_scaled_1sd")
    labels    <- c("SST (>18°C Threshold)", "Salinity (Absolute 1 PSU)", "Precipitation (Continuous 1 SD)")

    for (k in seq_along(exposures)) {
      exp_name <- exposures[k]
      b        <- sum_triple[exp_name, "coef"]
      se       <- sum_triple[exp_name, "se(coef)"]
      p_raw    <- sum_triple[exp_name, "Pr(>|z|)"]

      or_txt   <- paste0(round(exp(b), 2), " (", round(exp(b - 1.96*se), 2), ", ", round(exp(b + 1.96*se), 2), ")")

      triple_model_output <- rbind(triple_model_output, data.frame(
        Region = toupper(current_area), Lag = toupper(lag_name), Cases = actual_case_count,
        Variable = labels[k], OR = or_txt, P = format_p(p_raw), sig = p_raw < 0.05
      ))
    }
  }
}

# 3. Create word doc
ft_triple_table <- flextable(triple_model_output %>% select(-sig)) %>%
  font(fontname = "Times New Roman", part = "all") %>% fontsize(size = 10, part = "all") %>%
  bold(part = "header") %>% align(align = "center", j = c("Lag", "Cases", "OR", "P"), part = "all") %>%
  merge_v(j = c("Region", "Lag", "Cases")) %>% border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(i = seq(3, nrow(triple_model_output), by = 3), border = fp_border(color = "black", width = 1.0)) %>%
  set_header_labels(Region = "Study Region", Lag = "Lag Window", Cases = "Cases (N)", Variable = "Exposure Parameter", OR = "Fully Adjusted Odds Ratio (95% CI)", P = "p-value") %>%
  bold(i = Urban <- which(triple_model_output$sig), j = c("OR", "P")) %>% autofit()

doc_output <- read_docx() %>%
  body_add_par("Table Z.Z: Fully Adjusted Multi-Exposure Case-Crossover Sensitivity Matrix", style = "heading 1") %>%
  body_add_flextable(ft_triple_table) %>%
  body_add_par("\nNote:.", style = "Normal")

