# 11. Area stratified, SST and SSS hybrid logistic model, case crossover.
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# 1. Load libraries
library(dplyr)
library(survival)
library(ggplot2)
library(officer)
library(flextable)

# Apply lags 0-3
continuous_weather <- cc_data %>%
  distinct(area, date, SST = SSTmean, SSS = SSSmean) %>%
  arrange(area, date) %>%
  group_by(area) %>%
  mutate(
    SST_lag0_new = SST,
    SST_lag1_new = dplyr::lag(SST, n = 1),
    SST_lag2_new = dplyr::lag(SST, n = 2),
    SST_lag3_new = dplyr::lag(SST, n = 3),

    SSS_lag0_new = SSS,
    SSS_lag1_new = dplyr::lag(SSS, n = 1),
    SSS_lag2_new = dplyr::lag(SSS, n = 2),
    SSS_lag3_new = dplyr::lag(SSS, n = 3)
  ) %>%
  ungroup() %>%
  select(-SST, -SSS)

# Map environmental lags directly to cases
cc_clean_matched <- cc_data %>%
  select(id, area, isb, date) %>%
  left_join(continuous_weather, by = c("area", "date"))

# 2. Loop, run regressions 0-3 for each area
target_lags       <- c("lag0", "lag1", "lag2", "lag3")
unique_areas      <- c("cadiz", "charente-maritime", "stockholm")
two_model_results <- data.frame()
forest_results    <- data.frame()

format_p <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", round(p, 3)))
}

for (current_area in unique_areas) {
  for (lag_name in target_lags) {

    v_sst <- paste0("SST_", lag_name, "_new")
    v_sss <- paste0("SSS_", lag_name, "_new")

    # Filter out missing data
    model_subset <- cc_clean_matched %>%
      filter(area == current_area & !is.na(.data[[v_sst]]) & !is.na(.data[[v_sss]]) & !is.na(id)) %>%
      group_by(id) %>%
      filter(any(isb == 1) & any(isb == 0)) %>%
      ungroup()

    if (nrow(model_subset) < 10) next

    # Define populations
    actual_case_count <- sum(model_subset$isb == 1, na.rm = TRUE)

    # layout
    # 1. SST threshold vector tracking continuous values above 18°C
    model_subset$SST_threshold_var <- pmax(model_subset[[v_sst]] - 18, 0)
    # 2. Localized continuous standardized variables (Z-Scores)
    model_subset$sst_scaled_vector <- as.numeric(scale(model_subset[[v_sst]]))
    model_subset$sss_scaled_vector <- as.numeric(scale(model_subset[[v_sss]]))

    # SST adjusting for SSS
    mod_sst   <- clogit(isb ~ SST_threshold_var + sss_scaled_vector + strata(id), data = model_subset)
    sum_sst   <- summary(mod_sst)$coefficients
    b_sst     <- sum_sst["SST_threshold_var", "coef"]
    se_sst    <- sum_sst["SST_threshold_var", "se(coef)"]
    p_sst_val <- sum_sst["SST_threshold_var", "Pr(>|z|)"]

    or_sst_txt <- paste0(round(exp(b_sst), 2), " (", round(exp(b_sst - 1.96*se_sst), 2), ", ", round(exp(b_sst + 1.96*se_sst), 2), ")")
    p_sst_txt  <- format_p(p_sst_val)

    # forest plot
    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name), Variable = "SST (>18°C Threshold per 1°C increase)",
      OR = exp(b_sst), lower = exp(b_sst - 1.96*se_sst), upper = exp(b_sst + 1.96*se_sst)
    ))

    # SSS controlling for SST
    mod_sss   <- clogit(isb ~ sss_scaled_vector + sst_scaled_vector + strata(id), data = model_subset)
    sum_sss   <- summary(mod_sss)$coefficients
    b_sss     <- sum_sss["sss_scaled_vector", "coef"]
    se_sss    <- sum_sss["sss_scaled_vector", "se(coef)"]
    p_sss_val <- sum_sss["sss_scaled_vector", "Pr(>|z|)"]

    or_sss_txt <- paste0(round(exp(b_sss), 2), " (", round(exp(b_sss - 1.96*se_sss), 2), ", ", round(exp(b_sss + 1.96*se_sss), 2), ")")
    p_sss_txt  <- format_p(p_sss_val)

    # parameters for forest plot
    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name), Variable = "Salinity (Continuous per 1 SD change)",
      OR = exp(b_sss), lower = exp(b_sss - 1.96*se_sss), upper = exp(b_sss + 1.96*se_sss)
    ))

    #
    sst_row <- data.frame(Region = toupper(current_area), Lag = toupper(lag_name), Cases = actual_case_count, Variable = "SST (>18°C)", OR = or_sst_txt, P = p_sst_txt, sig = p_sst_val < 0.05)
    sss_row <- data.frame(Region = toupper(current_area), Lag = toupper(lag_name), Cases = actual_case_count, Variable = "Salinity (Continuous 1 SD)", OR = or_sss_txt, P = p_sss_txt, sig = p_sss_val < 0.05)
    two_model_results <- rbind(two_model_results, sst_row, sss_row)
  }
}

