# 1. Load libraries
library(dplyr)
library(survival)
library(ggplot2)
library(officer)
library(flextable)

# 2. Lags
continuous_weather <- cc_data %>%
  distinct(area, date, Pmean) %>%
  arrange(area, date) %>%
  group_by(area) %>%
  mutate(
    Pmean_lag0 = Pmean,
    Pmean_lag1 = dplyr::lag(Pmean, n = 1),
    Pmean_lag2 = dplyr::lag(Pmean, n = 2),
    Pmean_lag3 = dplyr::lag(Pmean, n = 3)
  ) %>%
  ungroup() %>%
  select(-Pmean)

# Map lags to cases
cc_clean_pmean <- cc_data %>%
  select(id, area, isb, date) %>%
  left_join(continuous_weather, by = c("area", "date"))

# 3. Loops, data outputs
target_lags         <- c("lag0", "lag1", "lag2", "lag3")
unique_areas        <- c("cadiz", "charente-maritime", "stockholm")
pmean_model_results <- data.frame()
forest_results      <- data.frame()

format_p <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", round(p, 3)))
}

# 4. Run Stratified lag loops across regions
for (current_area in unique_areas) {
  for (lag_name in target_lags) {

    target_var <- paste0("Pmean_", lag_name)

    # keep only fully-matched case-control strata
    pmean_final <- cc_clean_pmean %>%
      filter(area == current_area & !is.na(.data[[target_var]]) & !is.na(id)) %>%
      group_by(id) %>%
      filter(any(isb == 1) & any(isb == 0)) %>%
      ungroup()

    if (nrow(pmean_final) < 10) next

    #  count cases
    actual_case_count <- sum(pmean_final$isb == 1, na.rm = TRUE)

    # use per 1 SD change
    pmean_final$scaled_pmean <- as.numeric(scale(pmean_final[[target_var]]))

    # Fit Conditional Logistic Regression Model
    mod_pmean <- clogit(isb ~ scaled_pmean + strata(id), data = pmean_final)
    sum_pmean <- summary(mod_pmean)$coefficients

    b_pmean   <- sum_pmean["scaled_pmean", "coef"]
    se_pmean  <- sum_pmean["scaled_pmean", "se(coef)"]
    p_raw     <- sum_pmean["scaled_pmean", "Pr(>|z|)"]

    # Calculate Estimates
    or_val    <- exp(b_pmean)
    ci_lower  <- exp(b_pmean - 1.96 * se_pmean)
    ci_upper  <- exp(b_pmean + 1.96 * se_pmean)

    or_txt    <- paste0(round(or_val, 2), " (", round(ci_lower, 2), ", ", round(ci_upper, 2), ")")
    p_txt     <- format_p(p_raw)

    # Plotting
    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name),
      OR = or_val, lower = ci_lower, upper = ci_upper
    ))

    # Word Table
    pmean_model_results <- rbind(pmean_model_results, data.frame(
      Region = toupper(current_area), Lag = toupper(lag_name), Cases = actual_case_count,
      Variable = "Pmean (Continuous 1 SD)", OR = or_txt, P = p_txt, sig = p_raw < 0.05
    ))
  }
}

# 5.  Forest Plot
