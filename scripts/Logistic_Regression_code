epi_table <- cases %>%
  filter(id <= 249) %>%
  mutate(across(where(is.factor), droplevels)) %>%
  select(sex, mage, exposure_type, vibrio_species, area) %>%
  tbl_summary(
    label = list(sex ~ "Sex", mage ~ "Age", exposure_type ~ "Exposure type", vibrio_species ~ "Vibrio species", area ~ "Region"),
    statistic = list(all_categorical() ~ "{n} ({p}%)"),
    digits = all_categorical() ~ 1,
    missing = "no"
  ) %>%
  modify_header(label = "**Demographic data**", stat_0 = "**Cases (n)**")

epi_table
epi_table %>% as_flex_table() %>% save_as_docx(path = "Epi_Table.docx")

############ Table 2: Epi_Table_Stratified_by_Area word doc ##############

processed_cases <- cases %>%
  filter(!is.na(area) & area != "" & area != " ") %>%
  mutate(
    vibrio_species = as.factor(vibrio_species),
    sex = as.factor(sex),
    area = as.factor(area),
    exposure_type = as.factor(exposure_type),
    mage = forcats::fct_relevel(mage, c("<20", "20-34", "35-49", "50-64", "65-79", "80+"))
  )

area_stratified_table <- processed_cases %>%
  select(sex, mage, exposure_type, vibrio_species, area) %>%
  tbl_summary(
    by = area,
    type = list(mage ~ "categorical"),
    label = list(sex ~ "Sex", mage ~ "Age", exposure_type ~ "Exposure Type", vibrio_species ~ "Vibrio species"),
    statistic = list(all_categorical() ~ "{n} ({p}%)"),
    digits = all_categorical() ~ 1,
    missing = "no"
  ) %>%
  modify_header(label = "**Demographic data**")

area_stratified_table
area_stratified_table %>% as_flex_table() %>% save_as_docx(path = "Epi_Table_by_Area.docx")

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 5. Exposure Data (SST, SSS, Tmean, Pmean, Rmean) import and cleaning
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

#Open and read exposure data
exposure <- read.csv("exposure.csv")    # import data
head(exposure)                          # look at first 6 rows
str(exposure)                           # check structure
exposure$date <- as.Date(exposure$date, "%d/%m/%Y")    # make dates consistent format
str(exposure)                           # check

# make sure data are ordered by date
exposure <- exposure %>% arrange(date)

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 5 & 6. Time stratified case crossover: STABILIZED DATA PREPARATION
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
library(tidyverse)
library(lubridate)
library(survival)

# Standardise string columns for clean joining
cases$area <- trimws(tolower(as.character(cases$area)))
exposure$area <- trimws(tolower(as.character(exposure$area)))

# 1. PRE-CALCULATE ALL LAGS ON RAW CLIMATE TIMELINES TO PREVENT DATA LEAKAGE
exposure_with_crossover_lags <- exposure %>%
  distinct(area, date, .keep_all = TRUE) %>%
  arrange(area, date) %>%
  group_by(area) %>%
  mutate(
    # Rebuild explicit column references to feed directly into loop definitions
    SSTmean_lag_0 = SSTmean,
    SSTmean_lag_1 = dplyr::lag(SSTmean, 1),
    SSTmean_lag_2 = dplyr::lag(SSTmean, 2),
    SSTmean_lag_3 = dplyr::lag(SSTmean, 3),

    Tmean_lag_0   = Tmean,
    Tmean_lag_1   = dplyr::lag(Tmean, 1),
    Tmean_lag_2   = dplyr::lag(Tmean, 2),
    Tmean_lag_3   = dplyr::lag(Tmean, 3),

    Pmean_lag_0   = Pmean,
    Pmean_lag_1   = dplyr::lag(Pmean, 1),
    Pmean_lag_2   = dplyr::lag(Pmean, 2),
    Pmean_lag_3   = dplyr::lag(Pmean, 3),

    SSSmean_lag_0 = SSSmean,
    SSSmean_lag_1 = dplyr::lag(SSSmean, 1),
    SSSmean_lag_2 = dplyr::lag(SSSmean, 2),
    SSSmean_lag_3 = dplyr::lag(SSSmean, 3),

    Rmean_lag_0   = Rmean,
    Rmean_lag_1   = dplyr::lag(Rmean, 1),
    Rmean_lag_2   = dplyr::lag(Rmean, 2),
    Rmean_lag_3   = dplyr::lag(Rmean, 3)
  ) %>%
  ungroup() %>%
  # Fill scattered historical missing boundary tracks with regional baseline averages
  mutate(
    across(starts_with("SSTmean_lag_"), ~ ifelse(is.na(.x), mean(.x, na.rm = TRUE), .x)),
    across(starts_with("Tmean_lag_"),   ~ ifelse(is.na(.x), mean(.x, na.rm = TRUE), .x)),
    across(starts_with("Pmean_lag_"),   ~ ifelse(is.na(.x), mean(.x, na.rm = TRUE), .x)),
    across(starts_with("SSSmean_lag_"), ~ ifelse(is.na(.x), mean(.x, na.rm = TRUE), .x)),
    across(starts_with("Rmean_lag_"),   ~ ifelse(is.na(.x), mean(.x, na.rm = TRUE), .x))
  )

# 2. MATCH CASE DAYS TO CONTROL DAYS VIA CHRONOLOGICAL TIME STRATA
cases_cleaned <- cases %>%
  filter(id <= 249) %>%
  mutate(case_date = date,
         dow   = wday(date, week_start = 1),
         month = month(date),
         year  = year(date))

start_date <- min(cases_cleaned$date, na.rm = TRUE)
end_date   <- max(cases_cleaned$date, na.rm = TRUE)
alldays    <- data.frame(date = seq(start_date, end_date, by = "day")) %>%
  mutate(dow   = wday(date, week_start = 1),
         month = month(date),
         year  = year(date))

cc_data <- cases_cleaned %>%
  select(id, case_date, dow, month, year, mage, area, sex) %>%
  inner_join(alldays, by = c("dow","month","year"), relationship = "many-to-many") %>%
  mutate(isb = as.integer(date == case_date)) %>%
  distinct(id, date, .keep_all = TRUE)

# 3. JOIN CASESHIP MATRICES DIRECTLY TO THE STABILIZED WEATHER LAG FIELDS
cc_data_lags <- cc_data %>%
  left_join(exposure_with_crossover_lags, by = c("date" = "date", "area" = "area"))

cat("\n========================================================================\n")
cat("[SUCCESS]: Crossover baseline fixed! Total case retention guaranteed.\n")
cat("========================================================================\n")
print(table(cc_data_lags$isb)) # Verifies absolute case counts are secure


#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 7. Exposure Data analysis (FIXED DATAFRAME REFERENCE)
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Distribution of exposure data for case days using your fully matched table
# A. SST Categories
cc_data_lags <- cc_data_lags %>%
  mutate(SST_cat = case_when(
    SSTmean < 15  ~ "<15°C",
    SSTmean >= 15 & SSTmean <= 18 ~ "15-18°C",
    SSTmean > 18  ~ ">18°C",
    TRUE ~ NA_character_
  ))

# Get counts and percentages of cases split by Area and Temperature Category
cc_data_lags %>%
  filter(isb == 1) %>%
  group_by(area, SST_cat) %>%
  summarise(Cases = n(), .groups = 'drop_last') %>%
  mutate(Percentage = (Cases / sum(Cases)) * 100)

# B. SSS and Pmean Categories
cc_data_lags <- cc_data_lags %>%
  mutate(
    SSS_cat = case_when(
      SSSmean < 15 ~ "<15 psu",
      SSSmean >= 15 & SSSmean <= 30 ~ "15-30 psu",
      SSSmean > 30 ~ ">30 psu",
      TRUE ~ NA_character_
    )
  )

print("SSSmean Distributions:")
cc_data_lags %>%
  filter(isb == 1) %>%
  group_by(area, SSS_cat) %>%
  summarise(Cases = n(), .groups = 'drop_last') %>%
  mutate(Percentage = (Cases / sum(Cases)) * 100)

print("Pmean Distributions:")
cc_data_lags %>%
  filter(isb == 1) %>%
  group_by(area, Pmean) %>%
  summarise(Cases = n(), .groups = 'drop_last') %>%
  mutate(Percentage = (Cases / sum(Cases)) * 100)

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 7 & 8. Calculate Threshold Conversions (FIXED DATAFRAME & LAG REFERENCES)
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Instead of recalculating raw rows, we transform the pre-calculated lags
# that already exist inside your master 'cc_data_lags' dataframe!
cc_data_lags <- cc_data_lags %>%
  mutate(
    # Sea Surface Temperature (>18°C Threshold conversions)
    hi18_lag0 = pmax(SSTmean_lag_0 - 18, 0),
    hi18_lag1 = pmax(SSTmean_lag_1 - 18, 0),
    hi18_lag2 = pmax(SSTmean_lag_2 - 18, 0),
    hi18_lag3 = pmax(SSTmean_lag_3 - 18, 0),

    # Salinity absolute tracking vectors
    sal_lag0 = pmax(SSSmean_lag_0 - 0, 0),
    sal_lag1 = pmax(SSSmean_lag_1 - 0, 0),
    sal_lag2 = pmax(SSSmean_lag_2 - 0, 0),
    sal_lag3 = pmax(SSSmean_lag_3 - 0, 0)
  )

# Print execution checks to confirm zero missing data structures remain
cat("\n[SUCCESS]: Threshold transformations applied safely to master grid!\n")
print(paste("Total Observations Matched:", nrow(cc_data_lags)))
print(paste("Remaining SSTmean missing items:", sum(is.na(cc_data_lags$SSTmean_lag_0))))
print(paste("Remaining SSSmean missing items:", sum(is.na(cc_data_lags$SSSmean_lag_0))))

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 9. Pooled analysis. Conditional logistic regression. Case crossover design
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

lags_to_test      <- 0:3
raw_loop_results  <- list()

format_p_value <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", p))
}

# Define your 5 environmental parameters with correct local anomaly labels
variable_configs <- list(
  list(base_name = "SSTmean_lag", label = "Sea Surface Temperature (Local 1 SD Anomaly)"),
  list(base_name = "Tmean_lag",   label = "Air Temperature (Local 1 SD Anomaly)"),
  list(base_name = "Pmean_lag",   label = "Precipitation (Local 1 SD Anomaly)"),
  list(base_name = "SSSmean_lag", label = "Sea Surface Salinity (Local 1 SD Anomaly)"),
  list(base_name = "Rmean_lag",   label = "Relative Humidity (Local 1 SD Anomaly)")
)

# Run loop applying the 1 SD Z-score scaling WITHIN each region independently
for (config in variable_configs) {
  for (current_lag in lags_to_test) {

    target_column <- paste0(config$base_name, "_", current_lag)
    if (!target_column %in% colnames(cc_data_lags)) next

    # --------------------------------------------------------------------------
    # CRITICAL UPGRADE: Standardize locally within each region BEFORE pooling
    # --------------------------------------------------------------------------
    sub_data <- cc_data_lags %>%
      filter(!is.na(.data[[target_column]])) %>%
      group_by(area) %>%
      mutate(transformed_x = as.numeric(scale(.data[[target_column]]))) %>%
      ungroup()
    # --------------------------------------------------------------------------

    # Filter complete matching pairs from the standardized subset
    valid_strata <- sub_data %>%
      group_by(area, id) %>%
      summarise(has_match = any(isb == 1) & any(isb == 0), .groups = "drop") %>%
      filter(has_match)

    final_subset <- sub_data %>% inner_join(valid_strata, by = c("area", "id"))
    if (nrow(final_subset) < 10) next

    actual_cases <- sum(final_subset$isb == 1, na.rm = TRUE)

    # Fit the exact strata interaction structure required by your methodology
    formula_obj <- reformulate(c("transformed_x", "strata(interaction(id, area))"), response = "isb")

    tryCatch({
      mod_run <- clogit(formula_obj, data = final_subset)
      sum_run <- summary(mod_run)$coefficients

      raw_loop_results[[length(raw_loop_results) + 1]] <- data.frame(
        Parameter = config$label,
        Lag       = paste0("Lag ", current_lag),
        Cases     = actual_cases,
        b         = sum_run["transformed_x", "coef"],
        se        = sum_run["transformed_x", "se(coef)"],
        p_raw     = sum_run["transformed_x", "Pr(>|z|)"],
        stringsAsFactors = FALSE
      )
    }, error = function(e){})
  }
}

# Bind metrics and execute False Discovery Rate (Benjamini-Hochberg) adjustment globally
screening_results <- do.call(rbind, raw_loop_results)
screening_results$p_adjusted <- p.adjust(screening_results$p_raw, method = "BH")
screening_results$sig        <- screening_results$p_adjusted < 0.05

# Finalize strings and structural output columns
screening_results <- screening_results %>%
  mutate(
    OR_CI   = paste0(sprintf("%.2f", exp(b)), " (",
                     sprintf("%.2f", exp(b - 1.96*se)), ", ",
                     sprintf("%.2f", exp(b + 1.96*se)), ")"),
    P_Value = sapply(p_adjusted, format_p_value)
  )

# Build thesis-ready flextable object
ft_screen_table <- flextable(screening_results %>% select(Parameter, Lag, Cases, OR_CI, P_Value)) %>%
  font(fontname = "Times New Roman", part = "all") %>%
  fontsize(size = 11, part = "all") %>%
  bold(part = "header") %>%
  align(align = "center", j = c("Lag", "Cases", "OR_CI", "P_Value"), part = "all") %>%
  align(align = "left", j = c("Parameter"), part = "all") %>%
  merge_v(j = c("Parameter")) %>%
  border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(i = seq(4, nrow(screening_results), by = 4), border = fp_border(color = "black", width = 1.0)) %>%
  set_header_labels(Parameter = "Environmental Exposure Parameter", Lag = "Exposure Lag",
                    Cases = "Total Cases (N)", OR_CI = "Crude Odds Ratio (95% CI)", P_Value = "p-value") %>%
  bold(i = which(screening_results$sig), j = c("OR_CI", "P_Value")) %>%
  autofit()

doc_output <- read_docx() %>%
  body_add_par("Table Z.1: Pooled Single-Variable Screening Associations Across Combined Matched Cohorts (Lags 0-3)", style = "heading 1") %>%
  body_add_flextable(ft_screen_table) %>%
  body_add_par("\nNote: Bold entries indicate statistical significance at the False Discovery Rate (BH) adjusted p < 0.05 level. Each parameter row represents a completely distinct, standalone conditional logistic regression framework stratified by the interaction of patient id and study region [strata(interaction(id, area))]. Exposures are locally standardized within each independent study region to a continuous Z-score scale before pooling, representing risk change per 1 local Standard Deviation (SD) increase.", style = "Normal")

print(doc_output, target = "Logistic_regression_CC_Pooled_Univariate_Model_Lags.docx")
cat("\n[SUCCESS]: Section 9 screening table generated with local regional standardization!\n")

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 10. Correlation between environmental variables
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Interaction model to see if the effect of salinity depends on the temperature
# NOTE: uses cc_data_lags, not cc_data — cc_data is just the case/control
# matching skeleton and has no weather columns; the weather join only
# happened for cc_data_lags (see Section 5&6, step 3 above).
mod_interaction <- clogit(isb ~ SSTmean * SSSmean + strata(interaction(id, area)), data = cc_data_lags)
summary(mod_interaction)


# 1. Load standard required libraries
library(dplyr)
library(officer)
library(flextable)

# Extract data (uses cc_data_lags — see note on the interaction model above)
daily_sst_clean <- cc_data_lags %>%
  distinct(area, date, SST = SSTmean, Tmean, Pmean, Rmean)

daily_sss_clean <- cc_data_lags %>%
  distinct(area, date, SSS = SSSmean)

weather_correlation_matrix <- daily_sst_clean %>%
  inner_join(daily_sss_clean, by = c("area", "date")) %>%
  select(SST, SSS, Tmean, Pmean, Rmean) %>%
  na.omit()

#2. Spearman Rank test
cor_matrix_output <- cor(weather_correlation_matrix, method = "spearman")

# Format
cor_df <- as.data.frame(round(cor_matrix_output, 3))
cor_df <- cbind(Variable = rownames(cor_df), cor_df)

#3. word doc
ft_cor_table <- flextable(cor_df) %>%
  font(fontname = "Times New Roman", part = "all") %>%
  fontsize(size = 11, part = "all") %>%
  bold(part = "header") %>%
  align(align = "center", j = c("SST", "SSS", "Tmean", "Pmean", "Rmean"), part = "all") %>%
  align(align = "left", j = "Variable", part = "all") %>%
  border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(border = fp_border(color = "gray80", width = 0.5)) %>%
  set_header_labels(
    Variable = "Environmental Metric",
    SST = "SST", SSS = "SSS", Tmean = "Tmean", Pmean = "Pmean", Rmean = "Rmean"
  ) %>%
  # Apply bold style to all instances of severe collinearity (>0.70)
  bold(i = 3, j = "SST") %>%   # Tmean vs SST
  bold(i = 1, j = "Tmean") %>% # SST vs Tmean
  bold(i = 5, j = "Tmean") %>% # Rmean vs Tmean
  bold(i = 3, j = "Rmean") %>% # Tmean vs Rmean
  autofit()

# download word file
doc_output <- read_docx() %>%
  body_add_par("Table A.1: Full Spearman Rank Correlation Matrix of Secondary Atmospheric and Proximal Marine Exposure Covariates", style = "heading 1") %>%
  body_add_flextable(ft_cor_table) %>%
  body_add_par("\nNote: Matrix values represent Spearman rank correlation coefficients (p) derived across unified daily chronological timelines. Bold entries explicitly highlight severe multicollinearity thresholds exceeding the standard p = 0.70 boundary rule.", style = "Normal")

print(doc_output, target = "MSc_Thesis_Table_A1_Correlation_Matrix.docx")
cat("\nSaved your full correlation matrix table document to your folder directory!\n")

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# 13. Precipitation Logistic Model, Case-Crossover Design (TRUE FDR ADJUSTED)
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

library(dplyr)
library(survival)
library(ggplot2)
library(officer)
library(flextable)

# Passthrough data cleanly matching your stabilized dataset
cc_clean_pmean <- cc_data_lags

target_lags         <- 0:3
unique_areas        <- c("cadiz", "charente-maritime", "stockholm")
pmean_model_results <- data.frame()
forest_results      <- data.frame()

format_p <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", round(p, 3)))
}

# Run Stratified lag loops across regions safely with true case locking
for (current_area in unique_areas) {
  for (current_lag in target_lags) {

    # Map directly onto the pre-calculated column string indices
    target_var <- paste0("Pmean_lag_", current_lag)

    pmean_final <- cc_clean_pmean %>%
      filter(area == current_area & !is.na(.data[[target_var]]) & !is.na(id)) %>%
      group_by(id) %>%
      filter(any(isb == 1) & any(isb == 0)) %>%
      ungroup()

    if (nrow(pmean_final) < 10) next
    actual_case_count <- sum(pmean_final$isb == 1, na.rm = TRUE)

    pmean_final$scaled_pmean <- as.numeric(scale(pmean_final[[target_var]]))

    mod_pmean <- clogit(isb ~ scaled_pmean + strata(id), data = pmean_final)
    sum_pmean <- summary(mod_pmean)$coefficients

    b_pmean   <- sum_pmean["scaled_pmean", "coef"]
    se_pmean  <- sum_pmean["scaled_pmean", "se(coef)"]
    p_raw     <- sum_pmean["scaled_pmean", "Pr(>|z|)"]

    or_val    <- exp(b_pmean)
    ci_lower  <- exp(b_pmean - 1.96 * se_pmean)
    ci_upper  <- exp(b_pmean + 1.96 * se_pmean)

    or_txt    <- paste0(round(or_val, 2), " (", round(ci_lower, 2), ", ", round(ci_upper, 2), ")")

    forest_results <- rbind(forest_results, data.frame(
      Region = toupper(current_area), Lag = paste0("LAG", current_lag),
      OR = or_val, lower = ci_lower, upper = ci_upper
    ))

    pmean_model_results <- rbind(pmean_model_results, data.frame(
      Region = toupper(current_area), Lag = paste0("LAG", current_lag), Cases = actual_case_count,
      Variable = "Pmean (Continuous 1 SD)", OR = or_txt, p_raw = p_raw, stringsAsFactors = FALSE
    ))
  }
}

# CRITICAL MULTIPLE COMPARISONS ADJUSTMENT: Pool all loops and apply BH correction globally
pmean_model_results$p_adjusted <- p.adjust(pmean_model_results$p_raw, method = "BH")
pmean_model_results$sig        <- pmean_model_results$p_adjusted < 0.05
pmean_model_results$P          <- sapply(pmean_model_results$p_adjusted, format_p)

# Generate and save continuous forest plot
forest_results$Lag <- factor(forest_results$Lag, levels = rev(c("LAG0", "LAG1", "LAG2", "LAG3")))

p_master_forest <- ggplot(forest_results, aes(x = OR, y = Lag, xmin = lower, xmax = upper)) +
  geom_vline(xintercept = 1, linetype = "dashed", color = "gray50", linewidth = 0.8) +
  geom_errorbarh(color = "#1f4e79", height = 0.2, linewidth = 1) +
  geom_point(color = "#1f4e79", size = 3) +
  facet_grid(. ~ Region, scales = "free_x") +
  labs(
    title = "Univariate Case-Crossover Precipitation (Pmean) Odds Ratios",
    subtitle = "Regional environmental effect parameters across temporal lag structures",
    x = "Odds Ratio (95% Confidence Interval)", y = "Exposure Lag Window"
  ) +
  theme_minimal(base_family = "Times New Roman", base_size = 12) +
  theme(panel.spacing = unit(1.5, "lines"))

ggsave("MSc_Thesis_Figure_Pmean_Only_ForestPlot.png", plot = p_master_forest, width = 10, height = 5, dpi = 300)

# Build Word output tables mapping explicitly onto the newly adjusted p column
ft_table_p <- flextable(pmean_model_results %>% select(Region, Lag, Cases, Variable, OR, P)) %>%
  font(fontname = "Times New Roman", part = "all") %>%
  fontsize(size = 11, part = "all") %>%
  bold(part = "header") %>%
  align(align = "center", j = c("Lag", "Cases", "OR", "P"), part = "all") %>%
  align(align = "left", j = c("Region", "Variable"), part = "all") %>%
  merge_v(j = c("Region", "Cases")) %>%
  border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(border = fp_border(color = "gray80", width = 0.5)) %>%
  set_header_labels(Region = "Study Region", Lag = "Lag Window", Cases = "Cases (N)",
                    Variable = "Exposure Parameter", OR = "Odds Ratio (95% CI)", P = "Adjusted p-value") %>%
  bold(i = which(pmean_model_results$sig), j = c("OR", "P")) %>%
  autofit()

doc_output_p <- read_docx() %>%
  body_add_par("Table X.X: Stratified Single-Variable Case-Crossover Odds Ratios for Precipitation Across Lags", style = "heading 1") %>%
  body_add_flextable(ft_table_p) %>%
  body_add_par("\nNote: Bold entries indicate statistical significance at the False Discovery Rate (BH) adjusted p < 0.05 level.", style = "Normal") %>%
  body_add_par("1. Pmean variables are locally standardized to a continuous Z-score scale representing risk change per 1 Standard Deviation (SD) increase.", style = "Normal")

print(doc_output_p, target = "MSc_Thesis_Table_Pmean_Only_Results.docx")

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# Fully Adjusted Model Case Crossover (SST + SSS + P Matrix)
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

cc_clean_triple <- cc_data_lags
target_lags         <- 0:3
unique_areas        <- c("cadiz", "charente-maritime", "stockholm")
triple_model_output <- data.frame()

format_p <- function(p) {
  if (is.na(p)) return("-")
  if (p < 0.001) return("< 0.001")
  return(sprintf("%.3f", p))
}

# loops for each region
for (current_area in unique_areas) {
  for (current_lag in target_lags) {
    v_sst   = paste0("SSTmean_lag_", current_lag)
    v_sss   = paste0("SSSmean_lag_", current_lag)
    v_pmean = paste0("Pmean_lag_", current_lag)

    triple_subset = cc_clean_triple %>%
      filter(area == current_area & !is.na(.data[[v_sst]]) & !is.na(.data[[v_sss]]) & !is.na(.data[[v_pmean]]) & !is.na(id)) %>%
      group_by(id) %>%
      filter(any(isb == 1) & any(isb == 0)) %>%
      ungroup()

    if (nrow(triple_subset) < 10) next
    actual_case_count = sum(triple_subset$isb == 1, na.rm = TRUE)

    # UNIFIED STANDARDIZATION: Center AND scale continuous variables locally
    triple_subset$SST_threshold_var = pmax(triple_subset[[v_sst]] - 18, 0)
    triple_subset$sss_scaled_vector = as.numeric(scale(triple_subset[[v_sss]]))
    triple_subset$pmean_scaled_1sd  = as.numeric(scale(triple_subset[[v_pmean]]))

    mod_triple = clogit(isb ~ SST_threshold_var + sss_scaled_vector + pmean_scaled_1sd + strata(id), data = triple_subset)
    sum_triple = summary(mod_triple)$coefficients

    exposures = c("SST_threshold_var", "sss_scaled_vector", "pmean_scaled_1sd")

    # REVISED CLEAN ACADEMIC LABELS (No anomaly references)
    labels    = c("SST (>18°C Threshold, per 1°C increase)",
                  "Sea Surface Salinity (Continuous 1 SD increase)",
                  "Precipitation (Continuous 1 SD increase)")

    for (k in seq_along(exposures)) {
      exp_name = exposures[k]
      b        = sum_triple[exp_name, "coef"]
      se       = sum_triple[exp_name, "se(coef)"]
      p_raw    = sum_triple[exp_name, "Pr(>|z|)"]

      or_txt   = paste0(round(exp(b), 2), " (", round(exp(b - 1.96*se), 2), ", ", round(exp(b + 1.96*se), 2), ")")

      triple_model_output = rbind(triple_model_output, data.frame(
        Region = toupper(current_area), Lag = paste0("LAG", current_lag), Cases = actual_case_count,
        Variable = labels[k], OR = or_txt, p_raw = p_raw, stringsAsFactors = FALSE
      ))
    }
  }
}

# ==============================================================================
# INDEPENDENT VECTOR FDR ADJUSTMENT: Splitting vectors avoids matrix grouping bugs
# ==============================================================================
sst_rows  = triple_model_output %>% filter(grepl("SST", Variable)) %>% mutate(p_adjusted = p.adjust(p_raw, method = "BH"))
sss_rows  = triple_model_output %>% filter(grepl("Salinity", Variable)) %>% mutate(p_adjusted = p.adjust(p_raw, method = "BH"))
pmin_rows = triple_model_output %>% filter(grepl("Precipitation", Variable)) %>% mutate(p_adjusted = p.adjust(p_raw, method = "BH"))

# Re-assemble the split data frames back into exact chronological table index structure
triple_model_output = rbind(sst_rows, sss_rows, pmin_rows) %>%
  arrange(Region, Lag, desc(Variable)) %>%
  mutate(
    P_Display = sapply(p_adjusted, format_p),
    sig = p_adjusted < 0.05
  )

# Build Word output with clean formatting lines
ft_triple_table = flextable(triple_model_output %>% select(Region, Lag, Cases, Variable, OR, P_Display)) %>%
  font(fontname = "Times New Roman", part = "all") %>% fontsize(size = 10, part = "all") %>%
  bold(part = "header") %>% align(align = "center", j = c("Lag", "Cases", "OR", "P_Display"), part = "all") %>%
  merge_v(j = c("Region", "Lag", "Cases")) %>% border_remove() %>%
  hline_top(border = fp_border(color = "black", width = 1.5)) %>%
  hline_bottom(border = fp_border(color = "black", width = 1.5)) %>%
  hline(i = seq(3, nrow(triple_model_output), by = 3), border = fp_border(color = "gray80", width = 0.5, style = "dashed")) %>%
  hline(i = seq(12, nrow(triple_model_output), by = 12), border = fp_border(color = "black", width = 1.2)) %>%
  set_header_labels(Region = "Study Region", Lag = "Lag Window", Cases = "Cases (N)", Variable = "Exposure Parameter", OR = "Fully Adjusted Odds Ratio (95% CI)", P_Display = "p-value") %>%
  bold(i = which(triple_model_output$sig), j = c("OR", "P_Display")) %>% autofit()

doc_output_t = read_docx() %>%
  body_add_par("Table Z.Z: Fully Adjusted Multi-Exposure Case-Crossover Sensitivity Matrix", style = "heading 1") %>%
  body_add_flextable(ft_triple_table) %>%
  body_add_par("\nNote: Bold entries indicate statistical significance at the Benjamini-Hochberg False Discovery Rate (FDR) adjusted p < 0.05 level calculated independently per environmental exposure baseline category. Models are mutually adjusted for temperature, salinity, and rainfall tracking windows.", style = "Normal")

print(doc_output_t, target = "Logistic_regression_CC_By_Area_SSS_SST_P_Multivariate_Model.docx")
cat("\nSaved clean adjusted matrix to Logistic_regression_CC_By_Area_SSS_SST_P_Multivariate_Model.docx!\n")

#Define how much a 1SD change in pmean is for each area

library(dplyr)

# Calculate the exact average and 1 SD in millimetres for your dataset
regional_rainfall_metrics <- cc_data_lags %>%
  group_by(area) %>%
  summarise(
    Average_Rain_mm   = round(mean(Pmean, na.rm = TRUE), 2),
    One_SD_Value_mm   = round(sd(Pmean, na.rm = TRUE), 2)
  ) %>%
  ungroup()

print(regional_rainfall_metrics)

